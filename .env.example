MODEL_PROVIDER=opencode-go
OPENCODE_GO_API_KEY=
OPENCODE_GO_PLANNER=kimi-k2.6
OPENCODE_GO_VISION=kimi-k2.6

# Canonical public URL; use HTTPS and NODE_ENV=production when hosting.
APP_URL=http://127.0.0.1:4173
BILLING_REQUIRED=true
ACCOUNTS_DB=.runtime/accounts.sqlite

# OAuth web applications. Redirects: APP_URL/api/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Paddle Billing: use sandbox first. All three prices are one-time USD,
# tax_mode=external, with no regional overrides or discounts.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_CREATOR=
PADDLE_PRICE_STUDIO=

SOCIAL_GITHUB_URL=https://github.com/korbinjoe/logo2logo
SOCIAL_X_URL=https://x.com/korbinjoe
SOCIAL_YOUTUBE_URL=

# Vercel cloud deployment (see docs/vercel-deployment.md).
# Local server.js ignores these fields and continues using local SQLite/MFLUX.
# APP_URL above MUST be the canonical HTTPS site URL on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FAL_KEY=
