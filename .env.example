MODEL_PROVIDER=opencode-go
OPENCODE_GO_API_KEY=
OPENCODE_GO_PLANNER=kimi-k2.6
OPENCODE_GO_VISION=kimi-k2.6

# Canonical public URL; use HTTPS and NODE_ENV=production when hosting.
APP_URL=http://127.0.0.1:4173
BILLING_REQUIRED=true
ACCOUNTS_DB=.runtime/accounts.sqlite
# Server-side account UUID allowlist for the cloud credits dashboard /admin.html.
ADMIN_USER_IDS=

# OAuth web applications. Redirects: APP_URL/api/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PayPal global Checkout for a seller onboarded through paypal.cn.
# Use credentials and a webhook belonging to the SAME app/environment.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Live purchases stay disabled until global acquiring review and testing pass.
PAYPAL_CHECKOUT_ENABLED=false
# Public HTTPS endpoint; can point to a local tunnel for sandbox testing.
PAYPAL_WEBHOOK_URL=

SOCIAL_GITHUB_URL=https://github.com/korbinjoe/logo2logo
SOCIAL_X_URL=https://x.com/korbinjoe
SOCIAL_YOUTUBE_URL=

# Vercel cloud deployment (see docs/vercel-deployment.md).
# Local server.ts ignores these fields and continues using local SQLite/MFLUX.
# APP_URL above MUST be the canonical HTTPS site URL on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# cloudinary (no card required for Free) or r2. Keep server-side only.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional alternative: STORAGE_PROVIDER=r2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FAL_KEY=
