{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "data/svg-logos/**",
      "excludeFiles": "{models/**,.venv/**,outputs/**,.runtime/**,.env*,test/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=/api/:path*" },
    {
      "source": "/outputs/:path*",
      "destination": "/api/index?__path=/outputs/:path*"
    },
    {
      "source": "/reference/:path*",
      "destination": "/api/index?__path=/reference/:path*"
    }
  ]
}
